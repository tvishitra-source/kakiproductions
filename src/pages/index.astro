---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('work');
const filters = [
  'All',
  'Commercial',
  'Brand Film',
  'Public Service Announcement',
  'Documentary',
  'Corporate Film',
];
---

<Layout>
  <main>
    <section class="hero">
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        poster="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1600&q=80"
      >
        <source src="/videos/hero-bg.mp4" type="video/mp4" />
      </video>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1>Kaki Productions</h1>
        <p>Cinematic storytelling for modern brands.</p>
        <button class="hero-btn" id="scroll-to-work">View Selected Work</button>
      </div>
    </section>

    <section class="work" id="work">
      <h2>Our Work</h2>

      <div class="filters">
        {filters.map((f) => (
          <button class="filter-btn" data-filter={f}>{f}</button>
        ))}
      </div>

      <div class="grid">
        {projects.map((project) => (
          <a
          
            href={project.data.videoUrl}
            target="_blank"
            class="card"
            data-category={project.data.category}
          >
            <div class="media">
              <img src={project.data.thumbnail} alt={project.data.title} />
              <div class="overlay"></div>
            </div>
            <div class="info">
              <h3>{project.data.title}</h3>
              <span class="tag">{project.data.category}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="team">
      <h2>Who We Are</h2>
      <div class="team-grid">
        <div class="team-member">
          <div class="team-photo"></div>
          <h3>Name Placeholder</h3>
          <span class="role">Role Placeholder</span>
        </div>
        <div class="team-member">
          <div class="team-photo"></div>
          <h3>Name Placeholder</h3>
          <span class="role">Role Placeholder</span>
        </div>
        <div class="team-member">
          <div class="team-photo"></div>
          <h3>Name Placeholder</h3>
          <span class="role">Role Placeholder</span>
        </div>
      </div>
    </section>

    <section class="contact">
      <h2>Contact Us</h2>
      <div class="contact-details">
        <p><strong>Email:</strong> hello@kakiproductions.com</p>
        <p><strong>Phone:</strong> +60 12-345 6789</p>
      </div>
      <div class="social">
        <a href="https://instagram.com/kakiproductions" target="_blank">Instagram</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #000;
  }

  .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 2rem;
    opacity: 0;
    animation: heroFadeIn 1.4s ease forwards;
    animation-delay: 0.2s;
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-content h1 {
    font-size: 3.2rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0.02em;
  }

  .hero-content p {
    font-size: 1.15rem;
    color: #eee;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .hero-btn {
    background: none;
    border: 1px solid #fff;
    color: #fff;
    padding: 0.8rem 2rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hero-btn:hover {
    background: #fff;
    color: #000;
  }

  @media (max-width: 640px) {
    .hero-content h1 {
      font-size: 2.1rem;
    }
    .hero-content p {
      font-size: 1rem;
    }
  }

  .work {
    max-width: 1400px;
    margin: 0 auto;
    padding: 5rem 2rem;
  }

  h2 {
    font-size: 1.8rem;
    margin-bottom: 2rem;
    position: relative;
    display: inline-block;
  }

  h2::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 40px;
    height: 3px;
    background: var(--color-accent);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 3rem 0;
  }

  .filter-btn {
    background: none;
    border: 1px solid #ccc;
    color: #555;
    padding: 0.5rem 1.2rem;
    border-radius: 30px;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .card.hidden-filter {
    display: none;
  }

  .media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: #000;
  }

  .media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    transition: background 0.3s ease;
  }

  .card:hover .media img {
    transform: scale(1.04);
  }

  .card:hover .overlay {
    background: rgba(0, 0, 0, 0.25);
  }

  .info {
    margin-top: 1.2rem;
  }

  .card h3 {
    font-size: 1.15rem;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }

  .tag {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
  }

  .team {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem 2rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .team-member {
    text-align: center;
  }

  .team-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: #eee;
    margin-bottom: 1rem;
  }

  .team-member h3 {
    font-size: 1.1rem;
    margin: 0 0 0.3rem 0;
  }

  .team-member .role {
    font-size: 0.85rem;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem 2rem;
    text-align: center;
  }

  .contact-details p {
    font-size: 1.05rem;
    margin: 0.5rem 0;
  }

  .social {
    margin-top: 1.5rem;
  }

  .social a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--color-accent);
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const filterButtons = document.querySelectorAll<HTMLElement>('.filter-btn');

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  cards.forEach((card) => revealObserver.observe(card));

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const selected = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        if (selected === 'All' || category === selected) {
          card.classList.remove('hidden-filter');
        } else {
          card.classList.add('hidden-filter');
        }
      });
    });
  });

  const allButton = document.querySelector<HTMLElement>('[data-filter="All"]');
  if (allButton) allButton.classList.add('active');

  const scrollBtn = document.getElementById('scroll-to-work');
  scrollBtn?.addEventListener('click', () => {
    document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>