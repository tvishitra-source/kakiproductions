---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const existingProjects = await getCollection('work');

// Additional films. Existing content collection projects stay unchanged.
const newProjects = [
  {
    data: {
      title: 'K & K Signature Beauty Raya 2025: Misteri Kampung',
      category: 'Commercial',
      thumbnail: '/image/KKbeauty-thumbnail.jpg',
      videoUrl: 'https://youtu.be/6vp1exoca1Q',
    },
  },
  {
    data: {
      title: 'Ritelac Malaysia — Deepavali Film',
      category: 'Commercial',
      thumbnail: '/image/ritelac-deepavali-thumbnail.jpg',
      videoUrl: '/videos/ritelac-deepavali-2025.mp4',
    },
  },
];

// Put BOH Tea first, followed by the two new campaigns and the remaining films.
const allProjects = [...existingProjects, ...newProjects];
const displayOrder = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('boh')) return 0;
  if (t.includes('misteri kampung')) return 1;
  if (t.includes('ritelac')) return 2;
  if (t.includes('kawan')) return 3;
  if (t.includes('notebook') || t.includes('note book')) return 4;
  return 5;
};
const projects = [...allProjects].sort((a, b) =>
  displayOrder(a.data.title) - displayOrder(b.data.title)
);
const cardTitle = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('misteri kampung')) return 'Misteri Kampung';
  if (t.includes('ritelac')) return 'Ritelac — Deepavali Film';
  return title;
};

const filters = [
  'All',
  ...new Set(projects.map((project) => project.data.category)),
];
---

<Layout>
  <main>
    <!-- HERO -->
    <section class="hero" id="top">
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      >
        <source src="/videos/hero-bg.mp4" type="video/mp4" />
      </video>

      <div class="hero-overlay"></div>
      <div class="hero-grain"></div>

      <div class="hero-brand">
        <a href="#top" aria-label="Kaki Productions home">
          kaki<span>.</span>
        </a>
        <small>PRODUCTIONS</small>
      </div>

      <div class="hero-content">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          INDEPENDENT FILM PRODUCTION
        </div>

        <h1>
          Stories worth<br />
          <span>staying for.</span>
        </h1>

        <div class="hero-description">
          <p>
            Independent film production for brands,
            agencies and storytellers. From first idea
            to final frame.
          </p>

          <a href="#work" class="hero-link">
            EXPLORE OUR FILMS
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-bottom">
        <span>MADE IN MALAYSIA / MADE TO MOVE</span>
        <a href="#about">SCROLL TO EXPLORE ↓</a>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about" id="about">
    
<video
  class="about-video"
  autoplay
  muted
  loop
  playsinline
  preload="metadata"
  aria-hidden="true"
>
  <source src="/videos/about-bg.mp4" type="video/mp4" />
</video>

<div class="about-video-overlay" aria-hidden="true"></div>
      <div class="section-index">
        <span class="index-dot"></span>
        01 / ABOUT THE STUDIO
      </div>

      <div class="about-content">
        <h2>
          We like our films<br />
          with a little <span>character.</span>
        </h2>

        <div class="about-bottom">
          <span class="asterisk" aria-hidden="true">✳</span>

          <p>
            Kaki Productions is an independent production
            house creating commercials, brand films and
            visual stories. We bring ideas to life through
            thoughtful direction, strong visuals and
            end-to-end production.
          </p>
        </div>
      </div>
    </section>

    <!-- SELECTED WORK -->
    
<section class="work" id="work">
  <div class="work-heading">
    <div>
      <span class="section-index">
        <span class="index-dot"></span>
        02 / THE FILMS
      </span>

      <h2>Selected <span>work.</span></h2>
    </div>

    <p>
      A collection of stories<br />
      told through moving images.
    </p>
  </div>

  <div class="filters" aria-label="Filter projects">
    {filters.map((filter) => (
      <button
        type="button"
        class="filter-btn"
        data-filter={filter}
        aria-pressed={filter === 'All' ? 'true' : 'false'}
      >
        {filter}
      </button>
    ))}
  </div>

  <div class="project-grid">
    {projects.map((project, index) => (
      <a
        href={project.data.videoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class:list={["project-card", { "project-featured": index === 0 }]}
        data-category={project.data.category}
        aria-label={`Watch ${project.data.title}`}
      >
        <div class="project-media">
          {index === 0 && <span class="featured-label">FEATURED COMMERCIAL</span>}
          <img
            src={project.data.thumbnail}
            alt={project.data.title}
            loading="lazy"
          />
          <div class="project-overlay"></div>
          <span class="view-project">WATCH FILM ↗</span>
        </div>
        <div class="project-info">
          <div class="project-title">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{cardTitle(project.data.title)}</h3>
          </div>
          <span class="project-category">{project.data.category}</span>
        </div>
      </a>
    ))}
  </div>
</section>

    <!-- SERVICES -->
    <section class="services" id="services">
      <div class="section-index">
        <span class="index-dot"></span>
        03 / WHAT WE DO
      </div>

      <div class="services-layout">
        <div class="services-heading">
          <h2>
            The whole<br />
            <span>picture.</span>
          </h2>

          <p>
            From a passing thought to something
            worth watching. We handle the entire
            filmmaking process.
          </p>
        </div>

        <div class="services-list">
          <div class="service-item">
            <span>01</span>
            <h3>Creative Development</h3>
            
          </div>

          <div class="service-item">
            <span>02</span>
            <h3>Pre-Production</h3>
            
          </div>

          <div class="service-item">
            <span>03</span>
            <h3>Film Production</h3>
            
          </div>

          <div class="service-item">
            <span>04</span>
            <h3>Post-Production</h3>
            
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact" id="contact">
      <div class="contact-glow" aria-hidden="true"></div>

      <div class="contact-top">
        <span class="section-index">
          <span class="index-dot"></span>
          04 / THE NEXT PROJECT
        </span>

        <span class="contact-studio">
          KAKI PRODUCTIONS
        </span>
      </div>

      <div class="contact-content">
        <div class="contact-glass">
          <div class="glass-shine" aria-hidden="true"></div>

          <div class="contact-inner">
            <span class="contact-kicker">
              THE NEXT STORY STARTS HERE
            </span>

            <h2>
              Your idea.<br />
              <span>Our next film.</span>
            </h2>

            <p>
              Commercials, campaigns, collaborations.
              Tell us what you're imagining.
            </p>

            <a
              class="contact-cta"
              href="https://mail.google.com/mail/?view=cm&fs=1&to=kakiproduction00%40gmail.com&su=Project%20Enquiry%20-%20Kaki%20Productions"
target="_blank"
rel="noopener noreferrer"
            >
              <span>EMAIL US</span>
              <span aria-hidden="true">↗</span>
            </a>      
<a
  href="https://wa.me/60163265853?text=Hi%20Kaki%20Productions%2C%20I%27d%20like%20to%20enquire%20about%20a%20project."
  target="_blank"
  rel="noopener noreferrer"
  class="contact-whatsapp"
>
  WHATSAPP US ↗
</a>
          </div>
        </div>
      </div>

      <footer class="footer">
        <span>
          © {new Date().getFullYear()} KAKI PRODUCTIONS
        </span>

        <a
          href="https://instagram.com/ts_mathan"
          target="_blank"
          rel="noopener noreferrer"
        >
          INSTAGRAM ↗
        </a>

        <a href="#top">BACK TO TOP ↑</a>
      </footer>
    </section>
  </main>
</Layout>

<style>
